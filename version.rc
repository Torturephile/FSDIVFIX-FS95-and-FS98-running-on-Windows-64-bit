// Version information for FSDIVFIX.DLL
#define VS_FF_NONE 0
1 VERSIONINFO
FILEVERSION     2,2,3,0
PRODUCTVERSION  2,2,3,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0
FILEOS          0x40004      // VOS_NT_WINDOWS32
FILETYPE        0x2          // VFT_DLL
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "FSDIVFIX open-source project"
            VALUE "FileDescription",  "Flight Simulator 95/98 64-bit Windows division-fault fix (game module)"
            VALUE "FileVersion",      "2.2.3"
            VALUE "InternalName",     "FSDIVFIX"
            VALUE "LegalCopyright",   "Free to use and share. Contains no Microsoft code."
            VALUE "OriginalFilename", "FSDIVFIX.DLL"
            VALUE "ProductName",      "FSDIVFIX"
            VALUE "ProductVersion",   "2.2.3"
            VALUE "Comments",         "Lets FS95/FS98 reach their own integer-division handler on 64-bit Windows. Source included in the release."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
